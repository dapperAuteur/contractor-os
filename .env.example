SUPABASE__POSTGRES_URL=
SUPABASE__POSTGRES_USER=
SUPABASE__POSTGRES_HOST=
SUPABASE__SUPABASE_JWT_SECRET=
SUPABASE__NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE__POSTGRES_PRISMA_URL=
SUPABASE__POSTGRES_PASSWORD=
SUPABASE__POSTGRES_DATABASE=
SUPABASE__SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE__NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE__NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE__SUPABASE_SERVICE_ROLE_KEY=
SUPABASE__POSTGRES_URL_NON_POOLING=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...
STRIPE_CONTRACTOR_MONTHLY_PRICE_ID=price_...
STRIPE_CONTRACTOR_ANNUAL_PRICE_ID=price_...
STRIPE_CONTRACTOR_LIFETIME_PRICE_ID=price_...
STRIPE_LISTER_MONTHLY_PRICE_ID=price_...
STRIPE_LISTER_ANNUAL_PRICE_ID=price_...

# CashApp — alternative payment for lifetime purchases
NEXT_PUBLIC_CASHAPP_TAG=$WorkWitUS
# LMS — Teacher payout routing
# Comma-separated emails whose courses pay directly to the platform Stripe account (no Connect fees)
PLATFORM_TEACHER_EMAILS=bam@awews.com

# Shopify — generates unique single-use shirt promo codes per lifetime member
# SHOPIFY_SHOP_DOMAIN: your store's .myshopify.com URL (e.g. awesomewebstore.myshopify.com)
# SHOPIFY_ADMIN_API_TOKEN: Settings → Apps → Develop apps → Admin API token (needs write_price_rules scope)
# SHOPIFY_PRICE_RULE_ID: ID from Shopify Admin URL when viewing the discount: /admin/discounts/{ID}
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_...
SHOPIFY_PRICE_RULE_ID=

# Resend — transactional email for admin messages
# Get API key at https://resend.com → API Keys
# RESEND_FROM_EMAIL must be a verified domain in Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=admin@your-domain.com

# Admin dashboard access — only this email can visit /admin
ADMIN_EMAIL=your@email.com
# Same value as ADMIN_EMAIL — needed client-side to bypass paywall for admin
NEXT_PUBLIC_ADMIN_EMAIL=your@email.com

# Public site URL (used in Stripe redirect URLs and email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Umami Analytics (optional — privacy-first page & event tracking)
# Get these from your Umami dashboard: Settings → Websites → your site
# Self-hosted: set all three. UMAMI_HOST_URL enables the ad-blocker proxy (server-side only).
# Cloud: set only WEBSITE_ID. Leave SCRIPT_URL and HOST_URL blank.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
UMAMI_HOST_URL=

# PostHog — shared WitUS ecosystem product analytics (optional)
# BOTH ARE OPTIONAL. With no key the provider never calls posthog.init, capture() no-ops,
# and every page renders exactly as before. Both are publishable and ship in the browser
# bundle: a phc_ project key is not a secret. NEVER put a phx_ Personal API key here —
# that one IS a secret and is not needed for capture. NEXT_PUBLIC_* is inlined at build
# time, so a redeploy is required after setting these.
NEXT_PUBLIC_POSTHOG_KEY=
# MUST be set explicitly to the US host below. The shared project is US-region, and a US
# key pointed at PostHog's EU cluster fails SILENTLY: no error, no events, nothing to
# notice. Nothing in this repo reads it at runtime: the browser posts to the same-origin
# /ingest proxy, and the next.config.mjs rewrite names the upstream host literally, so a
# typo here cannot misroute ingest. It is declared because the ecosystem standard
# (lib/analytics/INTEGRATE.md in the witus repo) requires every app to state its region.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Switchy.io — tracked short links for blog, courses, and feature pages
# Get API token: Switchy dashboard → Settings → Integrations → API token
SWITCHY_API_TOKEN=
SWITCHY_DOMAIN=i.work.witus.online
# Comma-separated Switchy pixel UUIDs (Facebook, GA, TikTok, etc.)
# Find pixel IDs: Switchy dashboard → Settings → Pixels → copy UUID for each
SWITCHY_PIXEL_IDS=

# --- WitUS ecosystem integration ---
# Inbox (inbound): user feedback/help/bug is mirrored to BAM's one triage
# dashboard (inbox.witus.online -> Triage). Slug "work-witus". Non-blocking;
# if unset, the app still stores feedback locally and just skips the mirror.
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=work-witus
INBOX_INGEST_SECRET=
# Outbox (outbound): fireOutboxDrafts() posts job/invoice/union-doc activity to
# BAM's social as drafts (lib/outbox-trigger.ts). Slug "work-witus".
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_SOURCE_SLUG=work-witus
OUTBOX_INGEST_SECRET=
# Outbox gates: master kill-switch (must be "true" to fire) + the only user
# whose actions fire drafts during smoke (BAM's auth user id).
OUTBOX_TRIGGER_ENABLED=true
PRODUCT_OWNER_USER_ID=

# --- Error monitoring (Better Stack via the Sentry SDK) ---
# Entirely optional: with no DSN the SDK is never initialised, so nothing is captured and nothing
# is sent. SENTRY_DSN covers the server + edge runtimes; NEXT_PUBLIC_SENTRY_DSN is the browser one
# and is inlined at build time (a redeploy is required after setting it).
# Get the DSN: Better Stack -> Telemetry -> Sources -> connect a Sentry/SDK source.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional label for the events (falls back to VERCEL_ENV, then NODE_ENV).
SENTRY_ENVIRONMENT=
# Source-map upload only, for readable stack traces. Errors are captured without these.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Work.WitUS -> CentOS income events (Stage 2, Phase 2 of the database split).
# CentOS's finance forecast and planner used to read the cross-app `expected_payments` VIEW over
# our contractor_jobs + invoices. That view cannot survive the DB split, so we PUSH income events
# to CentOS and it keeps a local projection. Push, not pull, because CentOS is offline-first and
# its planner must render when this app is unreachable.
# See centenarian-os/plans/55-stage2-db-split.md.
#   INCOME_EVENTS_URL         — CentOS receiver, e.g. https://centenarianos.com/api/events/income
#   INCOME_EVENTS_SECRET      — shared HMAC secret. Generate >=32 random bytes
#                               (`openssl rand -hex 32`) and set the IDENTICAL value in CentOS.
#   INCOME_EVENTS_SOURCE_SLUG — optional sender id, defaults to work_witus.
# If URL or SECRET is unset the emitter no-ops and returns { stubbed: true }, so dev and preview
# never post to production CentOS.
INCOME_EVENTS_URL=
INCOME_EVENTS_SECRET=
INCOME_EVENTS_SOURCE_SLUG=

# Optional. Only set if CentOS's schedule receiver is NOT a sibling of the income one.
# By default this is derived from INCOME_EVENTS_URL by swapping /income for /work-schedule,
# and it reuses INCOME_EVENTS_SECRET — one trust relationship between these two apps, not two
# to rotate. Set explicitly only if the two receivers ever live on different hosts.
SCHEDULE_EVENTS_URL=

# ── Sign in with WitUS (ecosystem SSO) ─────────────────────────────────────────
# All optional, and the whole feature is DARK until WITUS_OIDC_CLIENT_ID is set: the
# "Sign in with WitUS" button renders nothing at all and sign-out stays purely local.
# An affordance a visitor cannot complete is worse than none.
#
# Work.WitUS is registered in the IdP (accounts.witus.online) as slug `work`:
#   WITUS_OIDC_CLIENT_ID     — always `witus-work`. Derived from the slug by
#                              gemini/witus lib/identity/clients.ts `clientIdFor()`.
#   WITUS_OIDC_CLIENT_SECRET — issued by BAM when provisioning this client. The SAME
#                              value must be set on the IdP as WITUS_OIDC_SECRET__WORK,
#                              or the token exchange 401s. Generate with
#                              `openssl rand -hex 32`.
# Both are server-only. Never prefix either with NEXT_PUBLIC_.
WITUS_OIDC_CLIENT_ID=
WITUS_OIDC_CLIENT_SECRET=

# NEXT_PUBLIC_SITE_URL (above) DOUBLES AS THE SSO HOST GATE and must be
# https://work.witus.online in production. This one Vercel project also serves
# www.badcba.com, which the IdP does not know: the redirect_uri, the CORS allowlist for
# the "Continue as <name>" probe, and post_logout_redirect_uri are all registered for
# work.witus.online only. The app compares the browser's origin against this value and
# hides the whole feature on the other host rather than offering a flow that 400s.

# Optional IdP endpoint overrides — only for a staging or self-hosted identity provider.
# Leave blank in production. The endsession and ecosystem-session-probe URLs are DERIVED
# from WITUS_OIDC_AUTHORIZE_URL, so accounts.witus.online is asserted in one place.
WITUS_OIDC_AUTHORIZE_URL=
WITUS_OIDC_TOKEN_URL=
WITUS_OIDC_USERINFO_URL=
WITUS_SSO_SESSION_URL=
